        </mxCell>
        <mxCell id="legendTitle" value="&lt;b&gt;Leyenda — cómo leer el diagrama&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="95" y="1050" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legendBody" value="&lt;b&gt;Cada recuadro (clase)&lt;/b&gt; tiene 3 partes: nombre de la clase arriba, atributos (datos que guarda) en el medio y métodos (acciones que puede hacer) abajo.&lt;br&gt;&lt;b&gt;-&lt;/b&gt; antes de un atributo = privado (solo la propia clase lo usa directamente). &lt;b&gt;+&lt;/b&gt; antes de un método = público (se puede llamar desde fuera).&lt;br&gt;&lt;b&gt;Flecha simple (línea con punta abierta)&lt;/b&gt; = asociación: una clase conoce/usa a otra (SistemaBancario gestiona Usuarios).&lt;br&gt;&lt;b&gt;Flecha con rombo relleno (◆—)&lt;/b&gt; = composición: el objeto del lado del rombo es dueño del otro y este no existe sin él (un Movimiento o un Prestamo no tienen sentido sin su Usuario).&lt;br&gt;&lt;b&gt;Los números 1 y *&lt;/b&gt; indican cuántos objetos participan en la relación: 1 Usuario puede tener * (muchos) Movimientos y * (muchos) Prestamos." style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="1074" width="930" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
